{
  "name": "animind-backend",
  "version": "1.0.0",
  "description": "Backend server for Animind - personal anime streaming platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:subtitles": "tsx src/scripts/migrateSubtitles.ts",
    "migrate:subtitles:apply": "tsx src/scripts/migrateSubtitles.ts --apply",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@clerk/backend": "^3.4.14",
    "@supabase/supabase-js": "^2.107.0",
    "axios": "^1.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
